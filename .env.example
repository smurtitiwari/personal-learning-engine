# ============================================================
# Learning Engine — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ── Supabase (non-secret — safe to store) ───────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# ── Supabase service role key (SECRET — never expose to browser) ─
# Location: Supabase Dashboard → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Development auth bypass ──────────────────────────────────
# UUID of a test user created in Supabase Auth → Users
# Used only when running locally without a real JWT.
# Leave EMPTY in production / Vercel.
SUPABASE_DEV_USER_ID=

# ── Google sign-in ────────────────────────────────────────────
# Production requires a real signed-in account. In Supabase Auth, enable the
# Google provider and add https://your-domain/api/auth/callback to Redirect URLs.
REQUIRE_AUTH=true
APP_URL=https://your-domain

# ── AI provider — DeepSeek ───────────────────────────────────
# DEEPSEEK_API_KEY is SECRET — keep it in local .env and in the
# deployment provider's encrypted environment variables. Never commit it.
DEEPSEEK_API_KEY=
#
# Non-secret config (safe to store here and in Vercel):
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ── Optional: semantic embeddings ───────────────────────────
# If set, uses OpenAI text-embedding-3-small for vector search.
# If not set, a deterministic fallback is used (fine for dev).
OPENAI_API_KEY=

# ── Server ───────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
