{
  "version": 2,
  "builds": [
    { "src": "index.html",       "use": "@vercel/static" },
    { "src": "app.js",           "use": "@vercel/static" },
    { "src": "styles.css",       "use": "@vercel/static" },
    { "src": "styles-mario.css", "use": "@vercel/static" },
    {
      "src": "server/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/server/index.js" },
    { "handle": "filesystem" },
    { "src": "/(.*)",    "dest": "/server/index.js" }
  ]
}
